{
  "name": "dsh-theme-claude",
  "version": "1.1.3",
  "description": "把 DeepSeek Harness 的 Web 界面换成 Claude 的视觉语言：暖白纸感底色、陶土橙点缀、CDS 圆角与柔和投影，以及衬线字体侧栏。",
  "type": "module",
  "license": "MIT",
  "author": "HelloGUOSHIJUN",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "claude",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloGUOSHIJUN/dsh-claude-theme.git"
  },
  "homepage": "https://github.com/HelloGUOSHIJUN/dsh-claude-theme#readme",
  "bugs": {
    "url": "https://github.com/HelloGUOSHIJUN/dsh-claude-theme/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "theme.css",
    "scripts/*.mjs",
    "locale/*.json",
    "docs/*.md",
    "icon.svg",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "node scripts/build.mjs && node scripts/check.mjs"
  }
}
